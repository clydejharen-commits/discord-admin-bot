# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Client ID of your bot application (Application ID)
CLIENT_ID=your-client-id-here

# Guild ID for guild-specific slash command registration (commands appear instantly)
# Leave empty to register commands globally instead (can take up to 1 hour)
DISCORD_GUILD_ID=

# MongoDB connection URI (already configured in Railway as MONGO_URI)
MONGO_URI=your-mongodb-connection-string-here
